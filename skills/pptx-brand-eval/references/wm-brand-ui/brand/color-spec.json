        "passes_aa_for": "type_of_any_size",
        "directions": [
          "Grounded Blue on Highlight Magenta",
          "Highlight Magenta on Grounded Blue"
        ]
      },
      "white_pairing": {
        "contrast_ratio": 3.5,
        "passes_aa_for": "large_text_only",
